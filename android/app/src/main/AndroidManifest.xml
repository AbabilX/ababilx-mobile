<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Local Share: LAN discovery (UDP multicast + subnet scan) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <!-- Bluetooth SCO for call audio below Android 12 (CallBluetoothManager). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS"/>
    <!-- Live CRM/Wall capture and the 1:1 video call camera. The camera is
         paused whenever the app leaves the foreground (no camera FGS type). -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" tools:node="remove"/>
    <!-- Local Share: writing received files into the public Downloads
         collection via MediaStore. Only needed below API 29 (scoped storage
         on 29+ needs nothing extra for MediaStore inserts). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <!-- In-app media grid (Signal's attachment keyboard model): the composer
         and the avatar picker read MediaStore directly so thumbnails are on
         screen before the system picker would even have opened. The system
         picker remains available as the "Files" escape hatch, so a user who
         denies these keeps a working way to attach.
         READ_MEDIA_VISUAL_USER_SELECTED is what makes Android 14's "Select
         photos" partial grant work rather than reading as a flat denial. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <!-- Keep FCM reliable in background (WhatsApp-style unrestricted) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Chat lock: fingerprint / face through the framework BiometricPrompt. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"/>

    <!-- Backup is off, and both halves are load-bearing. allowBackup="false"
         stops Google cloud backup on every version; on Android 12+ it no
         longer governs device-to-device transfer, which reads
         dataExtractionRules alone. Set only one and app data still leaves the
         phone by the other path. See res/xml/data_extraction_rules.xml for
         what would travel. -->
    <application
        android:label="AbabilX"
        android:name=".AbabilXApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- FCM server sends click_action=FLUTTER_NOTIFICATION_CLICK -->
            <intent-filter>
                <action android:name="FLUTTER_NOTIFICATION_CLICK"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </activity>

        <!-- External shares must not target the FlutterActivity directly.
             singleTop only reuses an Activity at the top of the selected task;
             a source app can otherwise create a second FlutterEngine and tear
             down the live call/notification owned by the first. This no-UI
             trampoline returns the intent to AbabilX's existing task. -->
        <activity
            android:name=".ShareIntakeActivity"
            android:exported="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="video/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="*/*"/>
            </intent-filter>
        </activity>

        <!-- Alternate launcher icons.
             The MAIN/LAUNCHER filter deliberately lives on aliases rather than
             on MainActivity: switching icons means disabling the component the
             launcher currently points at, and you cannot disable the Activity
             the app is running in. Exactly one alias is enabled at a time —
             `AppIconChannel` enables the chosen one and disables the rest.
             `.Launcher` is the default and must stay first.
             taskAffinity is repeated on every alias on purpose: an alias does
             NOT inherit it from its target activity, so leaving it off would
             launch MainActivity into a differently-affined task than the
             empty affinity the share intake and the call UI are built on. -->
        <!-- Hands the camera app a writable URI for the shot the media-send
             flow asked for. Scoped to that one cache directory: nothing else
             the app stores is reachable through it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.mediasend.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ms_file_paths" />
        </provider>

        <!-- A chat notification's photo, for SystemUI to draw. -->
        <provider
            android:name=".NotificationImageProvider"
            android:authorities="${applicationId}.notificationimages"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/notification_image_paths" />
        </provider>

        <!-- Ghost Chat files, served from memory so they never reach disk.
             Not exported: the only way in is a read permission this app grants
             on the chooser intent, for one launch of one viewer. -->
        <provider
            android:name=".GhostBlobProvider"
            android:authorities="${applicationId}.ghostblob"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- The native media-send flow: gallery grid, review pager, editor.
             Same task as MainActivity (taskAffinity="" is not inherited, so it
             is repeated here) — otherwise picking a photo would push a second
             entry into the recents list and Back would leave the app. -->
        <activity
            android:name=".mediasend.MediaSendActivity"
            android:exported="false"
            android:taskAffinity=""
            android:theme="@style/MediaSendTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- Where a tap on the ongoing-call notification lands. showWhenLocked
             is the point: SystemUI asks for the PIN before launching any
             notification Activity not declared this way, and MainActivity must
             never be. It holds nothing and only forwards — see
             CallReturnActivity.kt and CallLockScreen.kt. -->
        <activity
            android:name=".CallReturnActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity-alias
            android:name=".Launcher"
            android:targetActivity=".MainActivity"
            android:taskAffinity=""
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="AbabilX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Direct Share targets (DirectShareShortcuts). Read from the
                 enabled launcher alias, so every alias carries it. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/share_shortcuts"/>
        </activity-alias>
        <activity-alias
            android:name=".LauncherCalendar"
            android:targetActivity=".MainActivity"
            android:taskAffinity=""
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calendar"
            android:label="AbabilX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Direct Share targets (DirectShareShortcuts). Read from the
                 enabled launcher alias, so every alias carries it. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/share_shortcuts"/>
        </activity-alias>
        <activity-alias
            android:name=".LauncherCalculator"
            android:targetActivity=".MainActivity"
            android:taskAffinity=""
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_calculator"
            android:label="AbabilX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Direct Share targets (DirectShareShortcuts). Read from the
                 enabled launcher alias, so every alias carries it. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/share_shortcuts"/>
        </activity-alias>
        <activity-alias
            android:name=".LauncherNotes"
            android:targetActivity=".MainActivity"
            android:taskAffinity=""
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_notes"
            android:label="AbabilX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Direct Share targets (DirectShareShortcuts). Read from the
                 enabled launcher alias, so every alias carries it. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/share_shortcuts"/>
        </activity-alias>
        <!-- Kept out of the picker solely so users who selected a former
             icon retain a launch entry after upgrading. The next icon
             selection disables these aliases. -->
        <activity-alias
            android:name=".LauncherNight"
            android:targetActivity=".MainActivity"
            android:taskAffinity=""
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_night"
            android:label="AbabilX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Direct Share targets (DirectShareShortcuts). Read from the
                 enabled launcher alias, so every alias carries it. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/share_shortcuts"/>
        </activity-alias>
        <activity-alias
            android:name=".LauncherEmber"
            android:targetActivity=".MainActivity"
            android:taskAffinity=""
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ember"
            android:label="AbabilX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Direct Share targets (DirectShareShortcuts). Read from the
                 enabled launcher alias, so every alias carries it. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/share_shortcuts"/>
        </activity-alias>
        <activity-alias
            android:name=".LauncherPulse"
            android:targetActivity=".MainActivity"
            android:taskAffinity=""
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pulse"
            android:label="AbabilX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Direct Share targets (DirectShareShortcuts). Read from the
                 enabled launcher alias, so every alias carries it. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/share_shortcuts"/>
        </activity-alias>
        <activity-alias
            android:name=".LauncherWeather"
            android:targetActivity=".MainActivity"
            android:taskAffinity=""
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_weather"
            android:label="AbabilX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Direct Share targets (DirectShareShortcuts). Read from the
                 enabled launcher alias, so every alias carries it. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/share_shortcuts"/>
        </activity-alias>
        <activity-alias
            android:name=".LauncherInk"
            android:targetActivity=".MainActivity"
            android:taskAffinity=""
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ink"
            android:label="AbabilX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Direct Share targets (DirectShareShortcuts). Read from the
                 enabled launcher alias, so every alias carries it. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/share_shortcuts"/>
        </activity-alias>
        <activity-alias
            android:name=".LauncherIndigo"
            android:targetActivity=".MainActivity"
            android:taskAffinity=""
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_indigo"
            android:label="AbabilX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Direct Share targets (DirectShareShortcuts). Read from the
                 enabled launcher alias, so every alias carries it. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/share_shortcuts"/>
        </activity-alias>
        <activity-alias
            android:name=".LauncherForest"
            android:targetActivity=".MainActivity"
            android:taskAffinity=""
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_forest"
            android:label="AbabilX">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Direct Share targets (DirectShareShortcuts). Read from the
                 enabled launcher alias, so every alias carries it. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/share_shortcuts"/>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <service
            android:name="com.hiennv.flutter_callkit_incoming.CallkitNotificationService"
            android:foregroundServiceType="phoneCall|microphone"
            tools:replace="android:foregroundServiceType" />

        <!-- The one foreground service for a connected call: it owns the
             ongoing-call notification and carries the mediaProjection type for
             as long as a screen share lasts. Screen sharing used to run a
             second, separate service (flutter_local_notifications'
             generic ForegroundService, pinned here to
             foregroundServiceType="mediaProjection"), which meant the
             projection's lifetime and the service's lifetime were owned by
             different components with nothing sequencing them. See
             OngoingCallService.kt. -->
        <service
            android:name=".OngoingCallService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="phoneCall|microphone|mediaProjection" />

        <!-- FCM defaults: channel + white status-bar icon + brand tint -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_ababilx" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_color" />

        <!-- flutter_local_notifications: runs the Reply / Mark read buttons on
             a chat notification. The plugin does not declare it: without this
             receiver the buttons are drawn but pressing one does nothing. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"/>

        <!-- Logs delivered vs requested FCM priority (logcat tag AbabilXPush),
             the only way to see FCM demoting this install. Listens beside the
             plugin's receiver on the same broadcast; only Google Play services
             holds the SEND permission. See PushPriorityReceiver.kt. -->
        <receiver
            android:name=".PushPriorityReceiver"
            android:exported="true"
            android:permission="com.google.android.c2dm.permission.SEND">
            <intent-filter>
                <action android:name="com.google.android.c2dm.intent.RECEIVE" />
            </intent-filter>
        </receiver>

        <!-- flutter_local_notifications: scheduled notification receivers -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
