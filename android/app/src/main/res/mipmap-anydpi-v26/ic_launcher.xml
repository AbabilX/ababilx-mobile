<?xml version="1.0" encoding="utf-8"?>
<!-- White plate, black bird, same in light and dark. Padding is in the
     bitmap. Android 13 themed icons draw the monochrome bird instead. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_plate"/>
  <foreground android:drawable="@drawable/ic_launcher_bird"/>
  <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
