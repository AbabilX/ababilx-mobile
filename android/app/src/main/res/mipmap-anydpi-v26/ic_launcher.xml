<?xml version="1.0" encoding="utf-8"?>
<!-- The plate is constant white in light and dark theme alike. Only
     Android 13's themed icons change it: they draw the monochrome layer.
     Padding lives here. Raise the inset percent for more space around the
     mark; the foreground picture itself stays the desktop icon. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_plate"/>
  <foreground>
    <inset
        android:drawable="@drawable/ic_launcher_foreground"
        android:inset="24%" />
  </foreground>
  <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
