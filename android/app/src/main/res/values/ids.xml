<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- View.setTag(int, Object) demands an application resource id; an
         arbitrary int throws. This one tags a grid cell with the URI its
         in-flight thumbnail decode belongs to. -->
    <item name="media_send_thumb_key" type="id" />
    <!-- Stashes a view's pre-insets padding so MediaSendInsets can re-add a
         changed system-bar inset without compounding on top of the last one. -->
    <item name="media_send_base_padding" type="id" />
</resources>
