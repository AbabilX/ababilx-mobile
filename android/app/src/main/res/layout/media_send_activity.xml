<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/media_send_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/media_send_bg">

    <com.ababilx.app.mediasend.gallery.GalleryView
        android:id="@+id/gallery_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.ababilx.app.mediasend.review.ReviewView
        android:id="@+id/review_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.ababilx.app.mediasend.editor.EditorView
        android:id="@+id/editor_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <com.ababilx.app.mediasend.camera.CameraView
        android:id="@+id/camera_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
