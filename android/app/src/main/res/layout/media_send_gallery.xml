<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout">

    <LinearLayout
        android:id="@+id/gallery_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/gallery_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/media_send_close"
            android:src="@drawable/ic_ms_close" />

        <TextView
            android:id="@+id/gallery_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/media_send_recent"
            android:textColor="@color/media_send_on_dark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/gallery_camera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/media_send_camera"
            android:src="@drawable/ic_ms_camera" />

        <ImageButton
            android:id="@+id/gallery_files"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:selectableItemBackgroundBorderless"
            android:contentDescription="@string/media_send_files"
            android:src="@drawable/ic_ms_file" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gallery_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/gallery_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/media_send_empty"
        android:textColor="@color/media_send_muted"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/gallery_footer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/media_send_chrome"
        android:visibility="gone">

        <TextView
            android:id="@+id/gallery_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="20dp"
            android:textColor="@color/media_send_on_dark"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/gallery_next"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="16dp"
            android:background="@drawable/ms_circle_accent"
            android:contentDescription="@string/media_send_next"
            android:src="@drawable/ic_ms_check" />
    </FrameLayout>
</merge>
