<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/cell_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/media_send_chrome"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/cell_dim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/media_send_scrim"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cell_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="4dp"
        android:background="@drawable/ms_duration_pill"
        android:paddingStart="5dp"
        android:paddingTop="1dp"
        android:paddingEnd="5dp"
        android:paddingBottom="1dp"
        android:textColor="@color/media_send_on_dark"
        android:textSize="11sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/cell_badge"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/ms_selection_ring"
        android:gravity="center"
        android:textColor="@color/media_send_on_dark"
        android:textSize="12sp"
        android:textStyle="bold" />
</FrameLayout>
